# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (project 850gl5j0 / production are the defaults in sanity/env.ts;
# the site shows its built-in copy until the CMS has content)
NEXT_PUBLIC_SANITY_PROJECT_ID=850gl5j0
NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://www.capitalinvestmentllc.com

# --- GoHighLevel
# The forms' webhook is NOT set here: it lives in api/lead-config.php on SiteGround,
# written by the deploy workflow from the GHL_WEBHOOK_URL GitHub secret.
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty or "off" hides the chat.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Analytics (nothing loads when empty; the deploy workflow sets the old site's IDs)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_AHREFS_KEY=
