  RewriteRule ^wp-content/uploads/2025/06/ziff-ballet-opera-house(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/places/ziff-ballet-opera-house.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/07/downtown-miami-golden-hour(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/places/downtown-miami-golden-hour.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/07/eight-street-station(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/places/eighth-street-station.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/07/miami-cbd(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/places/miami-cbd-night.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/07/miami-dade-courthouse(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/places/miami-dade-courthouse.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/07/miami-metrorail-500x460-1(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/places/miami-metrorail.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/07/stephen-clark-center(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/places/stephen-clark-center.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/09/Monica(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/team/monica-morfin.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/09/Monica(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/team/monica-morfin.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/09/person(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/team/ramzah-khan.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/04/Connor(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/team/connor-zarebi.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/04/Connor(?:-scaled|-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/team/connor-zarebi.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2024/09/down-arrow\.svg$ https://%{HTTP_HOST}/images/icons/down-arrow.svg [R=301,L,NC]
  # Images of people no longer on the team, and any other old upload: 410 Gone.
  RewriteRule ^wp-content/uploads/ - [G,L,NC]
  # WordPress sitemaps and feeds.
  RewriteRule ^(?:sitemap_index|wp-sitemap|[a-z_-]+-sitemap\d*|wp-sitemap-[a-z0-9_-]+)\.xml$ https://%{HTTP_HOST}/sitemap.xml [R=301,L,NC]
  # WordPress-only paths that no longer exist: 410 Gone, so search engines drop them.
  RewriteRule ^(?:wp-admin|wp-includes|wp-json|wp-content)(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback|wp-comments-post|wp-config|readme|license)\.(?:php|html|txt)$ - [G,L,NC]
  RewriteRule ^(?:.+/)?(?:feed|trackback|embed|comments/feed)/?$ - [G,L,NC]
  RewriteRule ^(?:category|tag|author|elementor-hf|e-landing-page|elementor_library)/ - [G,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:rest_route|feed|attachment_id|elementor_library|s)= [NC]
  RewriteRule ^(?:index\.php)?$ - [G,L]
  # ---- end of old WordPress URLs ----

  # Pages live at /page/ (page/index.html): add the missing slash, on https
  # (absolute, so visitors behind SiteGround's proxy are not bounced through http).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The form's settings file and the upload tool's file list are never served.
<FilesMatch "^(lead-config\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # CSP for the site. Third parties allowed: Google Analytics / Tag Manager and
  # Ahrefs analytics (when their IDs are set), Google Maps (office maps),
  # Sanity images, and the GoHighLevel (LeadConnector) chat widget with its
  # anti-spam check. If you add tags in GTM that load other scripts, add their
  # domains here. The studio at /cms talks to many Sanity hosts and is
  # protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://analytics.ahrefs.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.gstatic.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://analytics.ahrefs.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com https://*.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.googletagmanager.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; media-src 'self' blob: https://cdn.sanity.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files forever, images for a month, pages always fresh.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType text/javascript .js
</IfModule>

# Compress text files. Apache may label .js as text/javascript or application/javascript: both are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/x-javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
