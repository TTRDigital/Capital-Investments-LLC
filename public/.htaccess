# Capital Investment LLC: static Next.js export on SiteGround (Apache).
# Does what a Node server would: canonical host, old-URL redirects, trailing
# slashes, security headers, caching and compression.

Options -Indexes
DirectoryIndex index.html index.php
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address: https://www.capitalinvestmentllc.com (with www), like the old site's canonical URLs.
  # (turn on "HTTPS Enforce" in SiteGround Site Tools > Security > SSL Manager too)
  RewriteCond %{HTTP_HOST} ^capitalinvestmentllc\.com$ [NC]
  RewriteRule ^(.*)$ https://www.capitalinvestmentllc.com/$1 [R=301,L]

  # ---- Old WordPress URLs (generated from the old site; keep above the trailing-slash rule) ----
  # The home page moved from /home/ to /.
  RewriteRule ^home/?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  # Team archive (and its pages) -> Our Team.
  RewriteRule ^team(?:/page/\d+)?/?$ https://%{HTTP_HOST}/our-team/ [R=301,L,NC]
  # Redirects the old site already had.
  RewriteRule ^investments-in-miami/?$ https://%{HTTP_HOST}/locations/miami-florida/ [R=301,L,NC]
  RewriteRule ^investments-in-washington-dc/?$ https://%{HTTP_HOST}/locations/washington-dc/ [R=301,L,NC]
  RewriteRule ^investments-in-northern-virginia/?$ https://%{HTTP_HOST}/locations/virginia/ [R=301,L,NC]
  RewriteRule ^about/?$ https://%{HTTP_HOST}/our-team/ [R=301,L,NC]
  RewriteRule ^contact/?$ https://%{HTTP_HOST}/contact-us/ [R=301,L,NC]
  RewriteRule ^properties/?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  RewriteRule ^author/ttrdigital/?$ https://%{HTTP_HOST}/ [R=301,L,NC]
  # Old ?page_id= / ?p= links (WordPress short links): 301 to the page, query dropped.
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=781(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=2764(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/terms-of-service/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=2757(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/contact-us/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=2649(?:&|$)
